# ============================================================================
# Document Service Configuration
# ============================================================================
# Copy this file to .env and fill in actual values.
# Environment variables always override .env file values.
# ============================================================================

# Application
APP_NAME=document-service
APP_ENV=development                    # development | staging | production
APP_VERSION=1.0.0

# ============================================================================
# Server
# ============================================================================
GRPC_PORT=50057                        # gRPC server port
METRICS_PORT=8081                      # Prometheus /metrics port

# ============================================================================
# Database (document schema)
# ============================================================================
DATABASE_URL=postgres://hris:changeme@localhost:5432/document_db?sslmode=disable

# ============================================================================
# Object Storage (MinIO / S3-compatible)
# ============================================================================
# For local development, start MinIO with:
#   docker run -p 9000:9000 -p 9001:9001 \
#     -e MINIO_ROOT_USER=minioadmin \
#     -e MINIO_ROOT_PASSWORD=minioadmin \
#     minio/minio server /data --console-address ":9001"
#
# For production, replace with your S3 bucket endpoint (e.g. s3.amazonaws.com)
# and provide IAM credentials via MINIO_ACCESS_KEY / MINIO_SECRET_KEY.

MINIO_ENDPOINT=localhost:9000          # MinIO/S3 endpoint (no protocol prefix)
MINIO_ACCESS_KEY=minioadmin            # Access key / AWS Access Key ID
MINIO_SECRET_KEY=minioadmin            # Secret key / AWS Secret Access Key (required)
MINIO_USE_SSL=false                    # true in production with TLS-enabled MinIO or S3

# ============================================================================
# JWT Public Key (for validating inbound tokens from auth-service)
# ============================================================================
AUTH_PUBLIC_KEY=                       # Base64-encoded RSA public key (PEM)

# ============================================================================
# Observability
# ============================================================================
LOG_LEVEL=info                         # debug | info | warn | error
OTEL_ENABLED=false                     # Enable OpenTelemetry tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
