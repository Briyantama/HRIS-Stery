# ============================================================================
# Audit Service Configuration
# ============================================================================
# Copy this file to .env and fill in actual values.
# Environment variables always override .env file values.
# ============================================================================

# Application
APP_NAME=audit-service
APP_ENV=development                    # development | staging | production
APP_VERSION=1.0.0

# ============================================================================
# Server
# ============================================================================
GRPC_PORT=50056                        # gRPC server port
METRICS_PORT=8081                      # Prometheus /metrics port

# ============================================================================
# Database (audit schema)
# ============================================================================
# Note: audit.audit_events is INSERT-ONLY (enforced by RLS policy).
# No UPDATE or DELETE is ever permitted on this table.
DATABASE_URL=postgres://hris:changeme@localhost:5432/audit_db?sslmode=disable

# ============================================================================
# Message Queue (NATS JetStream)
# ============================================================================
# Consumes all hris.> events to build an immutable audit trail.
# Subjects consumed: hris.identity.>, hris.workforce.>, hris.operations.>, hris.notifications.>
NATS_URL=nats://localhost:4222

# ============================================================================
# JWT Public Key (for validating inbound tokens from auth-service)
# ============================================================================
AUTH_PUBLIC_KEY=                       # Base64-encoded RSA public key (PEM)

# ============================================================================
# Observability
# ============================================================================
LOG_LEVEL=info                         # debug | info | warn | error
OTEL_ENABLED=false                     # Enable OpenTelemetry tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
