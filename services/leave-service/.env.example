# ============================================================================
# Leave Service Configuration
# ============================================================================

# gRPC Server Configuration
GRPC_PORT=50054                 # Port where gRPC server listens

# Database Configuration
DATABASE_URL=postgres://hris:changeme@localhost:5432/leave

# ============================================================================
# Message Queue (NATS JetStream)
# ============================================================================
NATS_URL=nats://localhost:4222     # For event publishing

# ============================================================================
# Leave Business Rules
# ============================================================================
DEFAULT_ANNUAL_LEAVE_DAYS=20       # Annual leave days allocated per year
DEFAULT_SICK_LEAVE_DAYS=10         # Sick leave days allocated per year

# ============================================================================
# Observability
# ============================================================================
LOG_LEVEL=info                     # debug, info, warn, error
OTEL_ENABLED=true                  # Enable OpenTelemetry tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
