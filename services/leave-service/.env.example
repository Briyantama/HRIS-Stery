# ============================================================================
# Leave Service Configuration
# ============================================================================
# Copy this file to .env and fill in actual values.
# Environment variables always override .env file values.
# ============================================================================

# Application
APP_NAME=leave-service
APP_ENV=development                    # development | staging | production
APP_VERSION=1.0.0

# ============================================================================
# Server
# ============================================================================
GRPC_PORT=50054                        # gRPC server port
METRICS_PORT=8081                      # Prometheus /metrics port

# ============================================================================
# Database (leave schema)
# ============================================================================
DATABASE_URL=postgres://hris:changeme@localhost:5432/leave_db?sslmode=disable

# ============================================================================
# Message Queue (NATS JetStream)
# ============================================================================
NATS_URL=nats://localhost:4222

# ============================================================================
# JWT Public Key (for validating inbound tokens from auth-service)
# ============================================================================
AUTH_PUBLIC_KEY=                       # Base64-encoded RSA public key (PEM)

# ============================================================================
# Leave Business Rules
# ============================================================================
DEFAULT_ANNUAL_LEAVE_DAYS=20           # Annual leave days allocated per employee per year
DEFAULT_SICK_LEAVE_DAYS=10             # Sick leave days allocated per employee per year

# ============================================================================
# Observability
# ============================================================================
LOG_LEVEL=info                         # debug | info | warn | error
OTEL_ENABLED=false                     # Enable OpenTelemetry tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
