# ============================================================================
# Attendance Service Configuration
# ============================================================================
# Copy this file to .env and fill in actual values.
# Environment variables always override .env file values.
# ============================================================================

# Application
APP_NAME=attendance-service
APP_ENV=development                    # development | staging | production
APP_VERSION=1.0.0

# ============================================================================
# Server
# ============================================================================
GRPC_PORT=50053                        # gRPC server port
METRICS_PORT=8081                      # Prometheus /metrics port

# ============================================================================
# Database (attendance schema)
# ============================================================================
DATABASE_URL=postgres://hris:changeme@localhost:5432/attendance_db?sslmode=disable

# ============================================================================
# Message Queue (NATS JetStream)
# ============================================================================
NATS_URL=nats://localhost:4222

# ============================================================================
# JWT Public Key (for validating inbound tokens from auth-service)
# ============================================================================
AUTH_PUBLIC_KEY=                       # Base64-encoded RSA public key (PEM)

# ============================================================================
# Attendance Business Rules
# ============================================================================
WORK_HOURS_PER_DAY=8                   # Standard work hours per day
LATE_THRESHOLD_MINUTES=15              # Minutes past shift start before marking late

# ============================================================================
# Observability
# ============================================================================
LOG_LEVEL=info                         # debug | info | warn | error
OTEL_ENABLED=false                     # Enable OpenTelemetry tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
