# ============================================================================
# Attendance Service Configuration
# ============================================================================

# gRPC Server Configuration
GRPC_PORT=50053                 # Port where gRPC server listens

# Database Configuration
DATABASE_URL=postgres://hris:changeme@localhost:5432/attendance

# ============================================================================
# Message Queue (NATS JetStream)
# ============================================================================
NATS_URL=nats://localhost:4222     # For event publishing

# ============================================================================
# Attendance Business Rules
# ============================================================================
WORK_HOURS_PER_DAY=8               # Standard work hours per day
LATE_THRESHOLD_MINUTES=15          # Minutes late before marking as late

# ============================================================================
# Observability
# ============================================================================
LOG_LEVEL=info                     # debug, info, warn, error
OTEL_ENABLED=true                  # Enable OpenTelemetry tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
