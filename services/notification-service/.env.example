# ============================================================================
# Notification Service Configuration
# ============================================================================

# gRPC Server Configuration
GRPC_PORT=50055                 # Port where gRPC server listens

# Database Configuration
DATABASE_URL=postgres://hris:changeme@localhost:5432/notification

# ============================================================================
# Message Queue (NATS JetStream)
# ============================================================================
NATS_URL=nats://localhost:4222     # For event consumption (leave, employee, auth events)

# ============================================================================
# Email (SMTP) Configuration
# ============================================================================
# Supported providers:
#   - Gmail: smtp.gmail.com:587 (use App Password, not regular password)
#   - Outlook: smtp-mail.outlook.com:587
#   - SendGrid: smtp.sendgrid.net:587 (username: apikey)
#   - AWS SES: email-smtp.region.amazonaws.com:587
#   - Custom SMTP server: your-server.com:port

SMTP_HOST=smtp.gmail.com            # SMTP server hostname
SMTP_PORT=587                       # SMTP port (25=plain, 587=TLS, 465=SSL)
SMTP_USERNAME=your-email@gmail.com  # SMTP authentication username
SMTP_PASSWORD=                      # SMTP authentication password (use app-specific password for Gmail)
SMTP_FROM_EMAIL=noreply@hris.local  # Email address for outgoing emails
SMTP_FROM_NAME=HRIS System          # Display name for outgoing emails
SMTP_TLS_ENABLED=true               # Enable TLS encryption (recommended: true)

# Email template directory
EMAIL_TEMPLATES_DIR=./templates     # Path to email HTML templates

# ============================================================================
# Observability
# ============================================================================
LOG_LEVEL=info                     # debug, info, warn, error
OTEL_ENABLED=true                  # Enable OpenTelemetry tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
