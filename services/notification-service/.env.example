# ============================================================================
# Notification Service Configuration
# ============================================================================
# Copy this file to .env and fill in actual values.
# Environment variables always override .env file values.
# ============================================================================

# Application
APP_NAME=notification-service
APP_ENV=development                    # development | staging | production
APP_VERSION=1.0.0

# ============================================================================
# Server
# ============================================================================
GRPC_PORT=50055                        # gRPC server port
METRICS_PORT=8081                      # Prometheus /metrics port

# ============================================================================
# Database (notification schema)
# ============================================================================
DATABASE_URL=postgres://hris:changeme@localhost:5432/notification_db?sslmode=disable

# ============================================================================
# Message Queue (NATS JetStream)
# ============================================================================
# Consumes events from: leave-service, employee-service, auth-service
NATS_URL=nats://localhost:4222

# ============================================================================
# JWT Public Key (for validating inbound tokens from auth-service)
# ============================================================================
AUTH_PUBLIC_KEY=                       # Base64-encoded RSA public key (PEM)

# ============================================================================
# Email (SMTP)
# ============================================================================
# Supported providers:
#   Gmail:    smtp.gmail.com:587      — use an App Password, not your account password
#   Outlook:  smtp-mail.outlook.com:587
#   SendGrid: smtp.sendgrid.net:587   — username: apikey, password: your API key
#   AWS SES:  email-smtp.<region>.amazonaws.com:587
#   Custom:   your-smtp-server.com:<port>

SMTP_HOST=smtp.gmail.com               # SMTP server hostname
SMTP_PORT=587                          # 25=plain | 587=STARTTLS | 465=SSL/TLS
SMTP_USERNAME=your-email@example.com   # SMTP auth username
SMTP_PASSWORD=                         # SMTP auth password (required)
SMTP_FROM_EMAIL=noreply@hris.local     # Sender address for outgoing emails
SMTP_FROM_NAME=HRIS System             # Sender display name
SMTP_TLS_ENABLED=true                  # Enable STARTTLS (recommended)

# Email template directory (relative to service working dir)
EMAIL_TEMPLATES_DIR=./templates

# ============================================================================
# Observability
# ============================================================================
LOG_LEVEL=info                         # debug | info | warn | error
OTEL_ENABLED=false                     # Enable OpenTelemetry tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
