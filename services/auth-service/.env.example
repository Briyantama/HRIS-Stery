# ============================================================================
# Auth Service Configuration
# ============================================================================
# Copy this file to .env and fill in actual values.
# Environment variables always override .env file values.
# ============================================================================

# Application
APP_NAME=auth-service
APP_ENV=development                    # development | staging | production
APP_VERSION=1.0.0

# ============================================================================
# Server
# ============================================================================
GRPC_PORT=50051                        # gRPC server port
METRICS_PORT=8081                      # Prometheus /metrics port

# ============================================================================
# Database (auth schema)
# ============================================================================
DATABASE_URL=postgres://hris:changeme@localhost:5432/auth_db?sslmode=disable

# ============================================================================
# Cache & Token Store (Redis)
# ============================================================================
# Use a full URL (takes precedence) or individual fields
REDIS_URL=redis://:changeme@localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=changeme

# ============================================================================
# Message Queue (NATS JetStream)
# ============================================================================
NATS_URL=nats://localhost:4222

# ============================================================================
# JWT — RSA Asymmetric Keys
# ============================================================================
# Generate with:
#   openssl genrsa -out private.key 2048
#   openssl rsa -in private.key -pubout -out public.key
#   cat private.key | base64 | tr -d '\n'   → AUTH_PRIVATE_KEY
#   cat public.key  | base64 | tr -d '\n'   → AUTH_PUBLIC_KEY
#
# The public key must also be provided to every other service that validates JWTs.

AUTH_PRIVATE_KEY=                      # Base64-encoded RSA private key (PEM)
AUTH_PUBLIC_KEY=                       # Base64-encoded RSA public key  (PEM)

# Alternative: raw PEM (newlines replaced with \n)
# AUTH_PRIVATE_KEY_BASE64=
# AUTH_PUBLIC_KEY_BASE64=

JWT_EXPIRATION_HOURS=1                 # Access token lifetime  (hours)
REFRESH_TOKEN_EXPIRATION_DAYS=7        # Refresh token lifetime (days)

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_REQUESTS=100                # Max requests per window per tenant
RATE_LIMIT_WINDOW_SECONDS=60           # Time window in seconds

# ============================================================================
# Observability
# ============================================================================
LOG_LEVEL=info                         # debug | info | warn | error
OTEL_ENABLED=false                     # Enable OpenTelemetry tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
