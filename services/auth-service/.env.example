# Auth service — local development environment
# Copy to .env and fill in values. Generate RSA keys with:
#   openssl genrsa -out auth-private.pem 2048
#   openssl rsa -in auth-private.pem -pubout -out auth-public.pem
# Then encode to base64:
#   cat auth-private.pem | base64 -w0 > auth-private.pem.base64
#   cat auth-public.pem | base64 -w0 > auth-public.pem.base64

DATABASE_URL=postgres://hris_app:hris_app_secret@localhost:6432/hris_db?sslmode=disable
REDIS_URL=redis://:hris_redis_secret@localhost:6379/0
NATS_URL=nats://localhost:4222
GRPC_PORT=50051

# PEM contents
AUTH_PRIVATE_KEY_
AUTH_PUBLIC_KEY_

# Other services validate JWTs with the public key only
AUTH_PUBLIC_KEY=CkhSSVMtU3RlcnktYXV0aC1zZXJ2aWNl
