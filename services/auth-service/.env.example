# ============================================================================
# Auth Service Configuration
# ============================================================================

# gRPC Server Configuration
GRPC_PORT=50051                 # Port where gRPC server listens

# Database Configuration
DATABASE_URL=postgres://hris:changeme@localhost:5432/auth

# ============================================================================
# JWT Configuration
# ============================================================================
# Auth uses RSA asymmetric keys for JWT signing
# Generate keys with:
#   openssl genrsa -out private.key 2048
#   openssl rsa -in private.key -pubout -out public.key
# Then encode with base64:
#   cat private.key | base64 | tr -d '\n'
#   cat public.key | base64 | tr -d '\n'

AUTH_PRIVATE_KEY=                  # Base64-encoded RSA private key
AUTH_PUBLIC_KEY=                   # Base64-encoded RSA public key (shared with all services)

JWT_EXPIRATION_HOURS=1             # Access token lifetime (hours)
REFRESH_TOKEN_EXPIRATION_DAYS=7    # Refresh token lifetime (days)

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_REQUESTS=100            # Requests per window
RATE_LIMIT_WINDOW_SECONDS=60       # Time window in seconds

# ============================================================================
# Observability
# ============================================================================
LOG_LEVEL=info                     # debug, info, warn, error
OTEL_ENABLED=true                  # Enable OpenTelemetry tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
