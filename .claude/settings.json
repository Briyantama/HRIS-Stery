{
  "permissions": {
    "allow": [],
    "priority": "user",
    "allowedTools": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Agent",
      "EnterPlanMode",
      "ExitPlanMode",
      "AskUserQuestion"
    ]
  },
  "hooks": {},
  "version": "1.0",
  "description": "Claude Code configuration for HRIS-Stery project",
  "skills": {
    "adr-review": {
      "path": ".claude/skills/adr-review/SKILL.md",
      "description": "Check if ADR exists and is relevant before writing code"
    },
    "migration-review": {
      "path": ".claude/skills/migration-review/SKILL.md",
      "description": "Ensure goose migrations are reversible and have RLS on tenant-scoped tables"
    },
    "event-review": {
      "path": ".claude/skills/event-review/SKILL.md",
      "description": "Check event envelope structure and idempotency patterns"
    },
    "architecture-review": {
      "path": ".claude/skills/architecture-review/SKILL.md",
      "description": "Verify clean architecture boundaries and business logic placement"
    },
    "go-style-review": {
      "path": ".claude/skills/go-style-review/SKILL.md",
      "description": "Check Go type safety, RLS context injection, and error handling"
    }
  },
  "subagents": {
    "go-backend-reviewer": {
      "path": ".claude/agents/go-backend-reviewer.md",
      "trigger": "code review for Go services"
    },
    "migration-reviewer": {
      "path": ".claude/agents/migration-reviewer.md",
      "trigger": "code review for database migrations"
    },
    "event-stream-reviewer": {
      "path": ".claude/agents/event-stream-reviewer.md",
      "trigger": "code review for Dragonfly stream event publishing/consumption"
    }
  },
  "decisionTree": {
    "path": ".claude/REVIEW_DECISION_TREE.md",
    "description": "Decision tree for choosing which skill/subagent to use"
  },
  "repository": {
    "name": "HRIS-Stery",
    "description": "Multi-tenant HRIS: one Go API module (apps/api) and a SvelteKit frontend",
