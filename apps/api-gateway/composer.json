{
  "name": "hris-stery/api-gateway",
  "type": "project",
  "description": "HRIS-Stery Laravel API Gateway",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "firebase/php-jwt": "^7.0.2",
    "guzzlehttp/guzzle": "^7.9",
    "laravel/framework": "^11.39.1",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^2.10",
    "spatie/laravel-permission": "^6.10"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.18",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.5",
    "pestphp/pest": "^3.7",
    "pestphp/pest-plugin-laravel": "^3.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "ignore": {
        "PKSA-mdq4-51ck-6kdq": "Composer blocks all Laravel 11.x; pinned to ^11.39.1 until advisory cleared upstream.",
        "PKSA-8qx3-n5y5-vvnd": "Composer blocks all Laravel 11.x; pinned to ^11.39.1 until advisory cleared upstream.",
        "PKSA-q46n-4fdk-zjr4": "Composer blocks all Laravel 11.x; pinned to ^11.39.1 until advisory cleared upstream.",
        "PKSA-qzrn-rnz3-85w1": "Composer blocks all Laravel 11.x; pinned to ^11.39.1 until advisory cleared upstream."
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
