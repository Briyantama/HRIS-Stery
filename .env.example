# HRIS-Stery API configuration. Copy to .env and fill in local values; never commit .env.

PORT=8000
LOG_LEVEL=info
DATABASE_URL=postgres://hris_app:changeme@127.0.0.1:5432/hris?sslmode=disable
# DB tests create and drop their own databases from this server (needs CREATEDB).
TEST_DATABASE_URL=postgres://postgres:changeme@127.0.0.1:5432/postgres?sslmode=disable

# Dragonfly (Redis protocol): cache, refresh tokens, event stream hris:events.
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=changeme
REDIS_TLS=false

# Comma-separated CIDRs whose X-Forwarded-For is trusted (empty = none).
TRUSTED_PROXY_CIDRS=

# RS256 keys: set the PEM or its base64 form for each.
AUTH_PRIVATE_KEY=
AUTH_PRIVATE_KEY_BASE64=
AUTH_PUBLIC_KEY=
AUTH_PUBLIC_KEY_BASE64=
JWT_EXPIRATION_HOURS=1
REFRESH_TOKEN_EXPIRATION_DAYS=7

# S3-compatible storage (RustFS in deploy/docker-compose.yml).
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=hris-documents
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme
S3_PATH_STYLE=true

# SMTP; an empty SMTP_HOST logs mails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=HRIS-Stery
SMTP_TLS_ENABLED=true
EMAIL_TEMPLATES_DIR=./services/notification/templates

# Frontend (apps/web)
VITE_API_URL=http://localhost:8000/api/v1
