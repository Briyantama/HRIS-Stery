# ============================================================================
# HRIS-Stery Environment Configuration
# ============================================================================
# Copy this file to .env and fill in actual values for your environment
# ============================================================================

# Application Configuration
APP_NAME=hris-stery
APP_ENV=development                 # development, staging, production
APP_VERSION=1.0.0

# ============================================================================
# Database Configuration
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hris
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hris

# Separate database URLs per service (if using docker-compose, format:
# postgres://user:password@postgres:5432/schema
# For local development:
# postgres://user:password@localhost:5432/schema

# ============================================================================
# Message Queue (NATS JetStream)
# ============================================================================
NATS_URL=nats://localhost:4222     # Format: nats://[user:password@]host:port

# ============================================================================
# Cache & Session Store
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                     # Leave empty if no password

# ============================================================================
# Observability
# ============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317   # OpenTelemetry collector
LOG_LEVEL=info                      # debug, info, warn, error

# ============================================================================
# Service Configuration (see individual service .env.example files for details)
# ============================================================================
# Services use environment variables like:
# - GRPC_PORT: gRPC server port per service
# - DATABASE_URL: PostgreSQL connection string
# - Service-specific vars (see service/.env.example)
